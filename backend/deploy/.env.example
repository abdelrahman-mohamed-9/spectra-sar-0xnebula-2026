POSTGRES_PASSWORD=replace-with-strong-local-password
MINIO_ROOT_USER=devadmin
MINIO_ROOT_PASSWORD=replace-with-strong-local-password

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
INTERNAL_API_KEY=

# Files stored privately in spectra-sar bucket; .env is not committed.

# T10 — must be a unique 32+ character secret per environment.
JWT_SECRET=
JWT_ISSUER=spectra-sar
JWT_AUDIENCE=spectra-sar-api
JWT_TTL_MINUTES=15
