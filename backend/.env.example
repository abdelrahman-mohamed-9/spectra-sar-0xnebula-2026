APP_NAME="SPECTRA-SAR Backend"
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS='["http://localhost:3000"]'
DATABASE_URL=postgresql://spectra:change-me@localhost:5432/spectra
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=spectra-sar
S3_ACCESS_KEY=local-dev-only
S3_SECRET_KEY=change-me

# Set a unique random secret (32+ chars); never commit actual credentials
INTERNAL_API_KEY=

# T10 — must be a unique 32+ character secret per environment.
JWT_SECRET=
JWT_ISSUER=spectra-sar
JWT_AUDIENCE=spectra-sar-api
JWT_TTL_MINUTES=15
