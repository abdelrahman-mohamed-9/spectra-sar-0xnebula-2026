# Copy to .env, replace all CHANGE_ME values with strong unique secrets.
POSTGRES_DB=spectra_sar
POSTGRES_USER=spectra
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_STRONG_PASSWORD
POSTGRES_PORT=5432
MINIO_ROOT_USER=CHANGE_ME_MINIO_ADMIN
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_STRONG_PASSWORD
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# For future services. Do NOT expose these values in the frontend.
DATABASE_HOST=postgres
DATABASE_PORT=5432
S3_ENDPOINT=http://minio:9000
S3_BUCKET=spectra-artifacts
SCHEMA_VERSION=0.1.0
